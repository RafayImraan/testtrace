# ---------------------------------------------------------------------
# Test Trace & Automate - example environment file
# Copy to .env  (docker compose reads ./.env automatically)
# ---------------------------------------------------------------------

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=tta
POSTGRES_PASSWORD=tta_pass
POSTGRES_DB=test_trace_automate
POSTGRES_HOST=postgres          # "localhost" when you run the backend outside docker
POSTGRES_PORT=5432
# Full connection string used by backend / worker / db scripts
DATABASE_URL=postgres://tta:tta_pass@postgres:5432/test_trace_automate

# --- Backend ----------------------------------------------------------
NODE_ENV=development
PORT=4000
# CHANGE ME in real deployments. Must be a long random string.
JWT_SECRET=dev_only_change_me_super_long_random_secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://localhost:4000
# Login rate limiting (protects against brute force)
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10
# Seed + migrate automatically when the backend container boots
RUN_MIGRATIONS_ON_START=true
RUN_SEED_ON_START=true

# --- Frontend ---------------------------------------------------------
# Empty = use the Vite/nginx proxy (same origin). Set to http://localhost:4000
# if you open the frontend from a different host without a proxy.
VITE_API_URL=
VITE_SOCKET_URL=

# --- Worker (automation) ---------------------------------------------
WORKER_POLL_INTERVAL_MS=3000
WORKER_ID=worker-1
BACKEND_URL=http://backend:4000
# worker logs in with this account to fetch queued runs / post results
WORKER_EMAIL=lead@tta.local
WORKER_PASSWORD=Lead@123
AUTOMATION_HEADLESS=true
AUTOMATION_RETENTION_HOURS=24

# --- Sample app (system under test) ----------------------------------
SAMPLE_APP_PORT=5000
SAMPLE_APP_URL=http://sample-app:5000
# intentional bug switches - used to demo failing automation
BUG_MODE=true
